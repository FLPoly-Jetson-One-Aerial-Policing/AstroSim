<?xml version="1.0" ?>
<!-- Placeholder world: ground, light, 1 ms physics step, headless. The aircraft (model://aircraft) is generated from the aircraft file at container start. Rotors are driven only by the gateway via gz::msgs::Actuators; there is no onboard controller. -->
<sdf version="1.6">
  <world name="multicopter">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Map ground: 800 m east-west (x) by 1100 m north-south (y), centred on the campus (shared/scene/campus.hpp: kMapCx, kMapCy), not the spawn pad, top face at z=0.
         A box, not a <plane>: plane collision is infinite whatever its <size>, and the map is meant to end
         (fly past the edge and there is nothing to land on). host/app/viewer.cpp draws the same extent. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>130 50 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>800 1100 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>800 1100 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- The aircraft: generated at container start by astrosim-modelgen into /tmp/astrosim/models (see entrypoint.sh).
         Its motor, drag, joint-state and odometry plugins live inside the generated model. -->
    <include>
      <uri>model://aircraft</uri>
    </include>
  </world>
</sdf>

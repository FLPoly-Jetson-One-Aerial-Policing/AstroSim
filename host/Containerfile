# Viewer image: raylib viewer rendered on a virtual X display (software GL) and served to a
# browser over noVNC at http://localhost:6080. Build from the repo root:
#   podman|docker build -f host/Containerfile .
FROM docker.io/library/ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake ninja-build pkg-config git ca-certificates \
        libgl1-mesa-dev libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
 && rm -rf /var/lib/apt/lists/*
# Ubuntu 24.04 has no raylib package: build it (static) from source.
RUN git clone --depth 1 --branch 5.5 https://github.com/raysan5/raylib.git /tmp/raylib \
 && cmake -S /tmp/raylib -B /tmp/raylib/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF \
 && cmake --build /tmp/raylib/build && cmake --install /tmp/raylib/build && rm -rf /tmp/raylib
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib/x86_64-linux-gnu/pkgconfig
COPY shared/proto/ /src/shared/proto/
COPY host/ /src/host/
RUN cmake -S /src/host -B /src/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /src/build --target viewer \
 && test -x /src/build/viewer

FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify libgl1-mesa-dri libglx-mesa0 libegl1 libx11-6 libxrandr2 libxinerama1 libxcursor1 libxi6 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/viewer /usr/local/bin/viewer
COPY host/viewer-entrypoint.sh /usr/local/bin/viewer-entrypoint.sh
EXPOSE 6080
CMD ["viewer-entrypoint.sh"]

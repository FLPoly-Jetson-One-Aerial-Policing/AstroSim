# AstroSim API documentation. Generate from the repo root with:  doxygen
# Output: build/docs/index.html (build/ is git-ignored).
# Only non-default settings are listed; see `doxygen -g` for the full reference.

PROJECT_NAME           = AstroSim
PROJECT_BRIEF          = "Jetson ONE flight simulator"
OUTPUT_DIRECTORY       = build
HTML_OUTPUT            = docs
CREATE_SUBDIRS         = NO

INPUT                  = README.md \
                         orchestrator/README.md \
                         shared \
                         gazebo-container \
                         fc-container
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
# Unit tests are not API documentation.
EXCLUDE_PATTERNS       = */tests/*
USE_MDFILE_AS_MAINPAGE = README.md
STRIP_FROM_PATH        = .
TOC_INCLUDE_HEADINGS   = 4
MARKDOWN_ID_STYLE      = GITHUB
STRIP_FROM_INC_PATH    = shared/aircraft/include \
                         shared/fc/include \
                         shared/log/include \
                         shared/net/include \
                         shared/proto/include \
                         gazebo-container/gateway \
                         gazebo-container/modelgen \
                         fc-container/bridge \
                         fc-container/px4

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = NO

# Treat missing or inconsistent documentation as an error so gaps are caught.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/doxygen-warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO

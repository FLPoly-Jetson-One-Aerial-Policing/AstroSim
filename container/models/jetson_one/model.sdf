    <link name="jetson_one/rotor_3">
      <pose>-1.05 -0.5 0.45 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>

cat > .gitignore << 'EOF'
# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# IDE files
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.pdb
*.mdb

# OS junk
.DS_Store
Thumbs.db

# Build outputs
*.apk
*.aab
*.unitypackage
EOF